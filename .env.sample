# Must be a Storefront API access token — NOT an Admin API token (shpat_...)
# Shopify Admin → Settings → Apps and sales channels → Develop apps
# → [Your app] → Configuration → enable Storefront API scopes → Install app
# → API credentials → Storefront API access token
SHOPIFY_STOREFRONT_ACCESS_TOKEN='Shopify Storefront Access Token'
SHOPIFY_STORE_DOMAIN='your-store.myshopify.com'

# Optional — powers the footer "Join the Ritual" newsletter (Klaviyo free tier: 250 profiles / 500 emails/mo)
# 1. Create account at https://www.klaviyo.com
# 2. Audience → Lists & Segments → Create list (e.g. "Newsletter") → copy List ID
# 3. Settings → API Keys → Create Private API Key with scopes: lists:write, profiles:write, subscriptions:write
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY='Y6wvkd'
KLAVIYO_PRIVATE_API_KEY='pk_Y6wvkd_c8aa4e0ea180ae368151482681ed8a14d3'
KLAVIYO_LIST_ID='RVjhwg'

# Optional — Judge.me Product Reviews API integration
# Judge.me Admin → Settings → Integrations → Developers → Public API Token
NEXT_PUBLIC_JUDGEME_PUBLIC_TOKEN=''
NEXT_PUBLIC_JUDGEME_SHOP_DOMAIN='your-store.myshopify.com'

# WhatsApp Click-to-Chat Phone (with country code, e.g. 923170692214)
NEXT_PUBLIC_WHATSAPP_PHONE='923170692214'

# Meta Pixel & Conversions API (CAPI) Integration
# 1. Meta Events Manager → Data Sources → Your Pixel → Settings
# 2. Copy Pixel ID to NEXT_PUBLIC_META_PIXEL_ID
# 3. Conversions API section → Set up manually → Generate access token → META_CAPI_ACCESS_TOKEN
# 4. (Optional for local testing) Test Events tab → Copy test code (e.g. TEST12345) to META_CAPI_TEST_EVENT_CODE
NEXT_PUBLIC_META_PIXEL_ID=''
META_CAPI_ACCESS_TOKEN=''
META_CAPI_TEST_EVENT_CODE=''

# Shopify Order Webhook Signing Secret (for Purchase CAPI tracking)
# Shopify Admin → Settings → Notifications → Webhooks → Create webhook
# Event: Order payment (orders/paid) — Recommended so only confirmed paid orders fire Purchase
# Format: JSON
# URL: https://your-domain.com/api/webhooks/shopify-order
# Copy the signing secret displayed at the bottom of the Webhooks page to SHOPIFY_WEBHOOK_SECRET
SHOPIFY_WEBHOOK_SECRET=''


