SHOPIFY_REVALIDATION_SECRET='Random Secret'
# Must be a Storefront API access token — NOT an Admin API token (shpat_...)
# Shopify Admin → Settings → Apps and sales channels → Develop apps
# → [Your app] → Configuration → enable Storefront API scopes → Install app
# → API credentials → Storefront API access token
SHOPIFY_STOREFRONT_ACCESS_TOKEN='Shopify Storefront Access Token'
SHOPIFY_STORE_DOMAIN='your-store.myshopify.com'

# Optional — powers the footer "Join the Ritual" newsletter (Klaviyo free tier: 250 profiles / 500 emails/mo)
# 1. Create account at https://www.klaviyo.com
# 2. Audience → Lists & Segments → Create list (e.g. "Newsletter") → copy List ID
# 3. Settings → API Keys → Create Private API Key with scopes: lists:write, profiles:write, subscriptions:write
KLAVIYO_PRIVATE_API_KEY=''
KLAVIYO_LIST_ID=''
